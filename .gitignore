# kitty: machine-local session snapshot.
# Saved by ctrl+shift+s (save_as_session). Contains per-machine cwd paths
# (git worktrees, project dirs) that don't exist on other machines, so it's
# transient local state — not shared config. startup_session in kitty.conf
# restores it on launch. See kitty.conf for the binding.
kitty/.config/kitty/last.session

# kitty: theme colors are generated by Noctalia's dynamic (wallpaper/palette)
# theming and written into current-theme.conf. Machine-local, regenerated on
# every theme change — kitty.conf includes it, but it is not shared config.
kitty/.config/kitty/current-theme.conf

# kitty: Noctalia's `kitten theme` also drops a generated theme under themes/
# and backs up kitty.conf to kitty.conf.bak on every theme switch. Both are
# machine-local regen artifacts, not shared config.
kitty/.config/kitty/themes/
kitty/.config/kitty/*.bak

# noctalia: GUI-managed override + runtime state live in ~/.local/state/noctalia,
# which is intentionally NOT tracked here. Only the hand-written config.toml is.
